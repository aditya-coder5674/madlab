FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates docker.io \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY server.js index.html codearena_final.html ./
COPY css ./css
COPY js ./js

ENV PORT=8000 \
    NODE_ENV=production \
    CODEARENA_DOCKER_BIN=/usr/bin/docker \
    CODEARENA_SANDBOX_IMAGE=madlab-runner:latest \
    TMPDIR=/opt/codearena/runfiles

EXPOSE 8000

CMD ["node", "server.js"]