CODEARENA_DOMAIN=api.your-domain.example
CODEARENA_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
CODEARENA_RUNFILES_DIR=/opt/codearena/runfiles
CODEARENA_REQUIRE_AUTH_FOR_EXECUTION=true
CODEARENA_AUTH_TTL_MS=86400000
CODEARENA_RUN_TIMEOUT_MS=30000

# Set these using your Judge0 provider's real server-side configuration.
# Leave the URL empty to keep Submit unavailable until a provider is configured.
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=
JUDGE0_AUTH_TOKEN=
JUDGE0_LANGUAGE_IDS={"python":71,"javascript":63,"java":62,"cpp":54,"c":50}